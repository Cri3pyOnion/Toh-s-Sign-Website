{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "720px", "wideSize": "1200px" },
		"color": {
			"defaultPalette": false,
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#ffffff" },
				{ "slug": "contrast", "name": "Contrast", "color": "#111111" },
				{ "slug": "accent", "name": "Accent", "color": "#0050b3" },
				{ "slug": "muted", "name": "Muted", "color": "#f4f4f5" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{ "slug": "body", "name": "Body", "fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "lineHeight": "1.6" },
		"elements": {
			"link": { "color": { "text": "var(--wp--preset--color--accent)" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
